{
	"schemaVersion": 1,
	"id": "ccr-crafts",
	"version": "${version}",
	"name": "CCR Crafts",
	"description": "This is a mod that adds various aesthetical blocks and items, that are related to the Communist Crimson Republic to the game.",
	"authors": [
		"duhrstloescher!",
		"LunaAstryx"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/ccr-crafts/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.duhrstloescher.ccr.CCRCrafts"
		],
		"client": [
			"net.duhrstloescher.ccr.CCRCraftsClient"
		],
		"fabric-datagen": [
			"net.duhrstloescher.ccr.CCRCraftsDataGenerator"
		]
	},
	"mixins": [
		"ccr-crafts.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}